# GitHub App Authentication
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=98765432
GITHUB_APP_PRIVATE_KEY_PATH=/opt/repo-agent/secrets/github-app.private-key.pem
# Or inline RSA private key PEM:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_BOT_USERNAME=app[bot]

# Gmail SMTP Dispatcher
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=myname@gmail.com
SMTP_PASSWORD=abcd1234efgh5678
SMTP_FROM_EMAIL=myname@gmail.com
SMTP_TO_EMAILS=myname@gmail.com,team@example.com
SMTP_ENABLED=true

# DeepSeek & AI Model Credentials
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Sandboxing & Orchestrator Behavior
AGENT_USE_DOCKER=true
REPO_AGENT_CONFIG=/opt/repo-agent/config.yaml
