# Ephemeral Sandbox Image for Autonomous GitHub Maintenance Agent
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install core utilities, git, compilers, Python 3.12, Node.js LTS
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    sudo \
    jq \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create runner non-root user
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && useradd -m -u 1000 -s /bin/bash runner \
    && echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER runner
WORKDIR /home/runner

# Install Antigravity CLI, OpenCode CLI, and uv for runner
RUN mkdir -p /home/runner/.gemini/antigravity-cli \
    && curl -fsSL https://antigravity.google/cli/install.sh | bash \
    && curl -fsSL https://opencode.ai/install | bash \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

ENV VIRTUAL_ENV="/home/runner/.venv"
ENV PATH="/home/runner/.venv/bin:/home/runner/.opencode/bin:/home/runner/.local/bin:${PATH}"

# Pre-install test runner, linter, and common project dependencies
RUN uv venv /home/runner/.venv \
    && uv pip install \
        "pytest>=8.0.0" \
        "pytest-asyncio>=0.23.0" \
        "flake8" \
        "ruff" \
        "mcp>=1.27.0" \
        "httpx>=0.27.0" \
        "pydantic>=2.0.0" \
        "python-dotenv>=1.0.0" \
        "pygithub>=2.10.0" \
        "pyyaml>=6.0.3" \
        "docker>=7.2.0" \
        "jinja2>=3.1.6" \
        "cryptography>=50.0.2"

WORKDIR /workspace

CMD ["/bin/bash"]
